# Preparación para la integración; el servidor demo todavía no utiliza estas variables.
# Copia a .env y completa allí los valores privados. .env está excluido de Git.
# No pegues secretos o tokens en el chat ni en archivos públicos.
STARTGG_EVENT_ID=1414455
STARTGG_PHASE_ID=2018125
STARTGG_EVENT_SELECTOR_USER_SLUG=user/1ba8f831
STARTGG_TOURNAMENT_SLUG=torneoprueba-1
STARTGG_CLIENT_ID=610
STARTGG_CLIENT_SECRET=86871e5222c7ec9c758fdd9427c6503eacc1e4bd853de1b6e8746a267ecdeedf
# Callback propuesto para pruebas locales; el endpoint se implementará al conectar OAuth.
STARTGG_REDIRECT_URI=http://127.0.0.1:4173/api/auth/startgg/callback
# Opcional para lectura centralizada, si se utiliza un token de servicio autorizado.
